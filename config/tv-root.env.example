# Settings for the Tizen Lite tooling on this host.
# Sourced by the watchdog; also read by bin/tvlib.py, so this is the only place
# the TV's address belongs. Environment variables win over this file.
TV_HOST=192.0.2.10

# Optional: needed only for `tv wake` (Wake-on-LAN).
# TV_MAC=aa:bb:cc:dd:ee:ff

# Optional: needed only for `tv dns` (DNS rewrite helper). Point at your own
# resolver's config file and container name; both are host-specific.
# TV_AGH_YAML=/etc/adguardhome/AdGuardHome.yaml
# TV_AGH_CONTAINER=adguardhome

# 0 = observe only (watchdog records TV state, never touches the TV).
# 1 = after each TV power-on, run one verification acquisition (`id -u` as root).
AUTO_ACQUIRE=1

APPLY=1
APPLY_GROUPS=home,memory,privacy,ota,voice,perf

TV_ROOT_TOOL=/usr/local/bin/tv-root

# 1 = after each power-on, re-apply /usr/local/bin/tv-debloat (runtime masks +
# stop ad/telemetry/update units). 0 = never touch services on power-on.
DEBLOAT=0
AGENT=1
